APP_NAME="Profilr - GitHub README Generator"
APP_KEY=base64:0w/p2B7pSxg2MQ3QiDfAHv1SEqJ0x/Ryj0Q/eO0QDls=
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# Your GitHub Personal Access Token (required)
# Create one at: https://github.com/settings/tokens
# Required scopes: read:user, repo (for private repo stats)
GITHUB_TOKEN=

# Enable public API endpoints (set to true on self-hosted instances)
ENABLE_API=true

# Landing page + builder UI. Set to true ONLY on your main instance.
# Leave false/absent on forks so they stay API-only.
# On Vercel: do NOT commit this — set ENABLE_UI=true in your main
# project's dashboard (Settings → Environment Variables) only.
ENABLE_UI=true

# Optional: canonical URL of your main instance, shown in the
# API-only 404 message on forks so users can find your landing page.
# UI_URL=https://your-main-app.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=warning

CACHE_STORE=array
SESSION_DRIVER=array
