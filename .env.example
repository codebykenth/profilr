# Application Name
APP_NAME="Profilr - GitHub README Generator"

# Application Key - For local development only.
# On Vercel deployments, APP_KEY is automatically derived from GITHUB_TOKEN via bootstrap/app.php when not explicitly set. Override here for hardening.
APP_KEY=base64:0w/p2B7pSxg2MQ3QiDfAHv1SEqJ0x/Ryj0Q/eO0QDls=
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# Your GitHub Personal Access Token (required)
# Create one at: https://github.com/settings/tokens
# Required scopes: read:user (public data) + repo (private repo stats)
GITHUB_TOKEN=

# Enable public API endpoints (default: true)
# Set to false to disable /api/* endpoints. Vercel clones default to true via bootstrap/app.php.
ENABLE_API=true

# Logging and Cache Configuration
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Stateless configuration - required for serverless deployments (e.g., Vercel)
CACHE_STORE=array
SESSION_DRIVER=array
